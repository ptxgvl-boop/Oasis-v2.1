local function CreatePlayerDropdown(box, idx, selectedTable, multi, addKeyPicker)
    multi = multi ~= false
    addKeyPicker = addKeyPicker ~= false

    local dd = box:AddDropdown(idx .. "Dropdown", {
        Text = "Targets",
        SpecialType = "Player",
        ExcludeLocalPlayer = true,
        Multi = multi,
        AllowNull = true,
        Searchable = true,
        FormatListValue = FormatPlayer,
        FormatDisplayValue = FormatPlayer,
        EnablePlayerImages = true,
        Callback = function(values)
            table.clear(selectedTable)
            if multi then
                for p in pairs(values) do
                    if not IsProtectedPlayer(p) then
                        selectedTable[p] = true
                    end
                end
            elseif values and not IsProtectedPlayer(values) then
                selectedTable[values] = true
            end
        end,
    })

    table.insert(TargetState.PlayerDropdowns, {
        Dropdown = dd,
        Selected = selectedTable,
        Values = selectedTable,
        Multi = multi,
    })

    if addKeyPicker then
        box:AddLabel("Add To List"):AddKeyPicker(idx .. "DropdownST", {
            Text = "Add To List",
            Mode = "Press",
            NoUI = true,
            Callback = function()
                local mouse = LP:GetMouse()
                local t = mouse.Target
                if not t or not t.Parent then return end
                local plr = Players_S:FindFirstChild(t.Parent.Name)
                if not plr or plr == LP or IsProtectedPlayer(plr) then return end
                if not multi then
                    dd:SetValue(plr)
                else
                    local tbl = {}
                    for k, v in pairs(dd.Value) do tbl[k] = v end
                    tbl[plr] = true
                    dd:SetValue(tbl)
                end
            end,
        })
    end

    return dd
end

local function CreateApplyButton(box, serverWide, blobMode, selectedTable)
    local label = serverWide and "Server" or "Selected"
    box:AddButton({
        Text = "Apply Method " .. label,
        Func = function()
            task.spawn(function()
                for _, plr in ipairs(GetTargets(serverWide, selectedTable)) do
                    ProcessPlayer(plr, false, serverWide, blobMode)
                end
            end)
        end,
    })
end

local function CreateLoopToggle(box, idx, flagKey, serverWide, blobMode, selectedTable)
    local label = serverWide and "Server" or "Selected"
    box:AddToggle(idx, {
        Text = "Loop Apply Method " .. label,
        Default = false,
        Tooltip = "Keeps applying selected methods to " .. label:lower() .. " players",
        Callback = function(on)
            TargetFlags[flagKey] = on
            if not on then return end
            task.spawn(function()
                while TargetFlags[flagKey] and task.wait() do
                    for _, plr in ipairs(GetTargets(serverWide, selectedTable)) do
                        if not TargetFlags[flagKey] then return end
                        ProcessPlayer(plr, true, serverWide, blobMode)
                    end
                    task.wait()
                end
            end)
        end,
    })
end

