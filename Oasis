-- ============================================
local Actions = {}

function Actions.Kill(player)
    local _, _, hum = GetChar(player)
    if hum and hum.Health > 0 then
        hum.BreakJointsOnDeath = false
        hum:ChangeState(Enum.HumanoidStateType.Dead)
    end
end

function Actions.Void(player)
    local _, root = GetChar(player)
    if root then
        root.CFrame = CFrame.new(0, 9e9, 0)
        root.Velocity = Vector3.new(0, 9e9, 0)
    end
end

function Actions.BringPlayer(player)
    local _, myRoot = GetChar()
    local _, theirRoot = GetChar(player)
    if myRoot and theirRoot then
        theirRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -5)
    end
end

function Actions.RemoveGucci(player)
    WarnNotify("RemoveGucci ยังไม่ได้ผูกกับเกม")
end

function Actions.EatAntiInput(player) end
function Actions.DeleteSeatables(player) end

function Actions.BreakLimb(player, limb)
    local char = GetChar(player)
    if not char then return end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            if limb == "All"
                or (limb == "Arms" and part.Name:find("Arm"))
                or (limb == "Legs" and part.Name:find("Leg")) then
                part.CFrame = CFrame.new(0, -100000, 0)
            end
        end
    end
end

-- ============================================
-- PROCESS PLAYER
-- ============================================
local function RunAction(name, fn, player)
    local ok, err = pcall(fn, player)
    if not ok then
        warn(("[Target] %s failed on %s: %s"):format(name, player.Name, tostring(err)))
    end
end

local function ProcessPlayer(player, loopMode, serverWide)
    if not player or not player.Parent then return end
    local methods = TargetState.TargetMethods
    local _, root = GetChar(player)

    if methods["Remove Invisibility"] and root then
        root.Massless = false
    end

    if methods.Bring then          RunAction("Bring", Actions.BringPlayer, player) end
    if methods.Kill then           RunAction("Kill", Actions.Kill, player) end
    if methods.Void then           RunAction("Void", Actions.Void, player) end
    if methods["Remove Gucci"] then RunAction("RemoveGucci", Actions.RemoveGucci, player) end
    if methods["Destroy Food"] then RunAction("EatAntiInput", Actions.EatAntiInput, player) end
    if methods["Delete Seatables"] then RunAction("DeleteSeatables", Actions.DeleteSeatables, player) end
    if methods["Delete Limbs"] then
        RunAction("BreakLimb", function(p)
            Actions.BreakLimb(p, TargetConfig.TargetedLimbCA)
        end, player)
    end

    if methods.Kick then
        if TargetConfig.KickServerMethod == "Void" and serverWide then
            RunAction("Kick", Actions.Void, player)
        elseif not serverWide and not loopMode then
            RunAction("Kick", Actions.Void, player)
        end
    end
end

