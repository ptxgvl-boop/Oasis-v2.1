local Players_S   = game:GetService("Players")
local RunService_S = game:GetService("RunService")
local LP = Players_S.LocalPlayer

local function GetChar(player)
    player = player or LP
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("realHrp")
    local hum = char:FindFirstChildOfClass("Humanoid")
    return char, root, hum
end

local function FormatPlayer(player, newline, shortSelf)
    if type(player) == "string" then
        player = Players_S:FindFirstChild(player)
    end
    if not player then return "???" end
    if player == LP and shortSelf then return "You" end
    local sep = newline and "\n" or ""
    return ("<b>%s</b> (%s@%s)"):format(player.DisplayName, sep, player.Name)
end

local function IsProtectedPlayer(player)
    -- ผูกกับระบบ whitelist ของคุณได้
    return false
end

local function GetTargets(serverWide, selectedTable)
    local list = {}
    if serverWide then
        for _, p in ipairs(Players_S:GetPlayers()) do
            if p ~= LP and not IsProtectedPlayer(p) then
                table.insert(list, p)
            end
        end
    else
        for p in pairs(selectedTable or TargetState.SelectedPlayers) do
            if p and p.Parent and not IsProtectedPlayer(p) then
                table.insert(list, p)
            end
        end
    end
    return list
end

local function WarnNotify(text, title)
    if Library and Library.Notify then
        Library:Notify({
            Title = title or "Resonance",
            Description = tostring(text),
            Time = 5,
        })
    else
        warn("[Target] " .. tostring(text))
    end
end

